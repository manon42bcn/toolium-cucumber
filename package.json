{
  "name": "toolium-cucumber",
  "displayName": "Toolium Cucumber",
  "description": "Gherkin editing for Toolium projects",
  "version": "0.1.1-dev.0",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Gherkin editing is available in Restricted Mode. Step navigation uses a Python interpreter and requires a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "toolium-cucumber.findByTag",
        "title": "Toolium Cucumber: Find by Tag in This Feature",
        "enablement": "editorLangId == gherkin"
      },
      {
        "command": "toolium-cucumber.goToStepDefinition",
        "title": "Toolium Cucumber: Go to Step Definition",
        "enablement": "isWorkspaceTrusted && (editorLangId == gherkin || editorLangId == python)"
      }
    ],
    "configuration": {
      "title": "Toolium Cucumber",
      "properties": {
        "tooliumCucumber.pythonInterpreter": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python executable for step discovery. Paths may be absolute or relative to the workspace folder. By default, look for a nearby .venv and then use Python on PATH."
        },
        "tooliumCucumber.stepImportPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "description": "Additional Python source roots for static step discovery. Relative paths are resolved against the workspace folder."
        }
      }
    },
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gherkin",
        "scopeName": "source.gherkin",
        "path": "./syntaxes/gherkin.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc && node scripts/build-grammar.cjs",
    "test": "npm run build && node --test",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@cucumber/gherkin": "^39.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/vscode": "~1.95.0",
    "typescript": "~5.9.3"
  }
}
